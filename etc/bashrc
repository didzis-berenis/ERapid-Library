export EOF_HOME="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"/..
export EOF_SRC=$EOF_HOME/libs
export LD_LIBRARY_PATH=$EOF_SRC:$LD_LIBRARY_PATH
export LD_LIBRARY_PATH=$FOAM_USER_LIBBIN:$LD_LIBRARY_PATH

eofPull() {
    git -C $EOF_HOME pull
}

# The commSplit libPstream override must be built before coupleElmer for
# OpenFOAM v1812, openfoam.org versions below 6, and openfoam.com v2312+
# when EOF_COMMSPLIT is set.
eofNeedsCommSplit() {
    local major=${WM_PROJECT_VERSION%%.*}
    case "$major" in
        v1812)
            return 0 ;;
        v*)
            [ -n "$EOF_COMMSPLIT" ] && [ "0$FOAM_API" -ge 2312 ] && return 0 ;;
        *)
            [ "$major" -lt 6 ] 2>/dev/null && return 0 ;;
    esac
    return 1
}

eofCompile() {
    if eofNeedsCommSplit; then
        local major=${WM_PROJECT_VERSION%%.*}
        if [ ! -d "$EOF_SRC/commSplit/$major" ]; then
            echo "eofCompile: no commSplit libPstream override for OpenFOAM $WM_PROJECT_VERSION" >&2
            echo "            (available: $(cd $EOF_SRC/commSplit && ls -d [0-9]* v* | tr '\n' ' '))" >&2
            if [ -n "$EOF_COMMSPLIT" ]; then
                echo "            unset EOF_COMMSPLIT to use the native world split (-mpi-split-by-appnum)" >&2
            fi
            return 1
        fi
        wmake $EOF_SRC/commSplit || return 1
    fi
    wmake $EOF_SRC/coupleElmer || return 1
    elmerf90 -o $EOF_SRC/Elmer2OpenFOAM.so -J$EOF_SRC $EOF_SRC/Elmer2OpenFOAM.F90 || return 1
    elmerf90 -o $EOF_SRC/OpenFOAM2Elmer.so -J$EOF_SRC $EOF_SRC/OpenFOAM2Elmer.F90
}

eofUpdate() {
   eofPull
   eofCompile
}
